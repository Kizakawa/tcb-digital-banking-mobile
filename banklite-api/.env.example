PORT=3000
NODE_ENV=development
# Bắt buộc cấu hình khóa bí mật tối thiểu 32 ký tự (sinh ngẫu nhiên bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_SECRET
ADMIN_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_ADMIN_KEY

# Bảo mật OTP: Luôn đặt false để KHÔNG bao giờ trả mã OTP trong JSON HTTP Response
EXPOSE_DEMO_OTP=false

# Chỉ bật true khi chạy sau Reverse Proxy tin cậy (Nginx/Cloudflare)
TRUST_PROXY=false
