<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOtpVerify"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtBackOtp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textSize="28sp"
        android:textColor="#222222"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/txtOtpLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◆◆"
        android:textColor="#EF2B2D"
        android:textSize="30sp"
        android:layout_marginTop="36dp" />

    <TextView
        android:id="@+id/txtOtpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vui lòng nhập mã xác thực được gửi tới số điện thoại"
        android:textColor="#222222"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/edtOtpCode"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Nhập OTP"
        android:inputType="number"
        android:maxLength="6"
        android:textSize="24sp"
        android:letterSpacing="0.25"
        android:background="#FFFFFF"
        android:layout_marginTop="42dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#BBBBBB" />

    <TextView
        android:id="@+id/txtOtpTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã OTP sẽ hết hiệu lực sau 60 giây"
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/txtOtpMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OTP mô phỏng: 656565"
        android:textColor="#777777"
        android:textSize="13sp"
        android:layout_marginTop="10dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnVerifyOtp"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Xác thực"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#000000"
        android:layout_marginBottom="24dp" />

</LinearLayout>