<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutLoginRegisterIntro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtBackLoginIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textColor="#222222"
        android:textSize="28sp"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/txtLoginIntroLogo"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:text="◆◆"
        android:textSize="36sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="#EF2B2D"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp" />

    <TextView
        android:id="@+id/txtLoginIntroTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng ký dịch vụ ngân hàng điện tử"
        android:textColor="#222222"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="28dp" />

    <TextView
        android:id="@+id/txtLoginIntroSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đây là tên đăng nhập của bạn"
        android:textColor="#555555"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtMaskedPhoneIntro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="******4321"
        android:textColor="#222222"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:layout_marginTop="22dp" />

    <TextView
        android:id="@+id/txtAccountNumberPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số tài khoản: -"
        android:textColor="#555555"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/txtAccountFeePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phí số tài khoản: 0 VND"
        android:textColor="#D71920"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="6dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnContinueLoginIntro"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Tiếp tục"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#000000"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnChangeLoginName"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Thay đổi tên đăng nhập"
        android:textAllCaps="false"
        android:textColor="#222222"
        android:backgroundTint="#FFFFFF"
        android:layout_marginBottom="24dp" />

</LinearLayout>