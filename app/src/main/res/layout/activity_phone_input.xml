<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutPhoneInput"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtBackPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textSize="28sp"
        android:textColor="#222222"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/txtPhoneLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◆◆"
        android:textColor="#EF2B2D"
        android:textSize="30sp"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/txtPhoneTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vui lòng nhập số điện thoại của bạn"
        android:textColor="#222222"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginTop="26dp" />

    <TextView
        android:id="@+id/txtPhoneHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số điện thoại sẽ được dùng để xác thực OTP và đăng nhập ứng dụng."
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/edtOpenPhone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Số điện thoại"
        android:inputType="phone"
        android:maxLength="10"
        android:textSize="22sp"
        android:background="#FFFFFF"
        android:layout_marginTop="46dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#BBBBBB" />

    <TextView
        android:id="@+id/txtPhoneMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#D71920"
        android:textSize="14sp"
        android:layout_marginTop="12dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnContinuePhone"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Tiếp tục"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#000000"
        android:layout_marginBottom="24dp" />

</LinearLayout>