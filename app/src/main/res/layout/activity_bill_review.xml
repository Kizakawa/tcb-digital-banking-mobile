<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutBillReviewScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <LinearLayout
        android:id="@+id/layoutBillReviewRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBackBillReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="28sp"
            android:textColor="#222222"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtBillReviewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bạn đang thanh toán"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:id="@+id/cardBillInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtReviewProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Internet ADSL FPT"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtReviewCustomerCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BY123456"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txtReviewCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nguyen Lan Huong"
                android:textColor="#555555"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtReviewPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kỳ: Tháng 4, 2021"
                android:textColor="#555555"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtReviewAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VND 50,000"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtFromAccountTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Từ"
            android:textColor="#555555"
            android:textSize="16sp"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/cardPaymentAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtPaymentAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tài khoản thanh toán"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtPaymentBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số dư: 0 VND"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Thanh toán ngay"
            android:textAllCaps="false"
            android:backgroundTint="#000000"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtReviewMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D71920"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="14dp" />

    </LinearLayout>

</ScrollView>