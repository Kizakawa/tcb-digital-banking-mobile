<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAccountNumberTypeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutAccountNumberType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBackAccountType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="28sp"
            android:textColor="#222222"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtAccountTypeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn số tài khoản"
            android:textColor="#222222"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="44dp" />

        <LinearLayout
            android:id="@+id/cardNormalAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#EAF3F7"
            android:padding="20dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▱"
                android:textColor="#222222"
                android:textSize="48sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tài khoản thường"
                android:textColor="#222222"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hoàn toàn miễn phí, đầy đủ tiện ích và tính năng của tài khoản thanh toán"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardBeautifulAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF2CC"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰"
                android:textColor="#222222"
                android:textSize="48sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tài khoản số đẹp"
                android:textColor="#222222"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chọn số đẹp cho tài lộc, vận may đang đến gần"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>