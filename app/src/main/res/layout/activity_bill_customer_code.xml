<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCustomerCodeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtCloseCustomerCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="×"
        android:textSize="28sp"
        android:textColor="#222222"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/txtCodeLine1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thanh toán"
        android:textColor="#222222"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="36dp" />

    <TextView
        android:id="@+id/txtBlueServiceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="hóa đơn internet"
        android:textColor="#2B8DCC"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtProviderNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="cho Internet ADSL FPT"
        android:textColor="#222222"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtContractLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="hợp đồng số"
        android:textColor="#777777"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/edtCustomerCode"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Nhập mã hợp đồng / mã khách hàng"
        android:inputType="text"
        android:background="#F2F2F2"
        android:padding="14dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnContinueBill"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Tiếp tục"
        android:textAllCaps="false"
        android:layout_marginTop="24dp"
        android:backgroundTint="#000000"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/txtBillInputMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#D71920"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="16dp" />

</LinearLayout>