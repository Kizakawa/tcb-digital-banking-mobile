<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhập OTP"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#D71920" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OTP demo: 123456"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/edtOtpForgot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="OTP"
        android:inputType="number"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/txtOtpForgotMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D71920"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnVerifyOtpForgot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xác nhận OTP"
        android:layout_marginTop="24dp"
        android:backgroundTint="#D71920" />

</LinearLayout>