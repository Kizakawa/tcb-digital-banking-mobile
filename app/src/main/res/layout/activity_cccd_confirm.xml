<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCccdConfirmScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutCccdConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBackCccdConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="28sp"
            android:textColor="#222222"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtCccdConfirmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xác nhận thông tin"
            android:textColor="#222222"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/txtCccdConfirmSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nếu có thông tin chưa khớp, vui lòng thực hiện chụp lại CCCD/CCCD"
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="26dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin CMND/CCCD"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/txtCccdInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#222222"
            android:textSize="15sp"
            android:lineSpacingExtra="10dp" />

        <Button
            android:id="@+id/btnConfirmCccdInfo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Xác nhận"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000"
            android:layout_marginTop="34dp" />

        <Button
            android:id="@+id/btnRetakeCccd"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Chụp lại"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>