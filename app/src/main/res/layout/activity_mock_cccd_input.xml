<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutMockCccdScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutMockCccd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBackMockCccd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#222222"
            android:textSize="30sp"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/txtMockCccdTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhập dữ liệu CCCD mô phỏng"
            android:textColor="#222222"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="34dp" />

        <TextView
            android:id="@+id/txtMockCccdDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Do chưa tích hợp OCR CCCD thật, vui lòng nhập dữ liệu mô phỏng như kết quả quét CCCD."
            android:textColor="#555555"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Họ và tên"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp" />

        <EditText
            android:id="@+id/edtMockFullName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: Phan Quoc Bao"
            android:inputType="textPersonName"
            android:textSize="17sp"
            android:background="#FFFFFF"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số CCCD"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/edtMockCccdNumber"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nhập đúng 12 chữ số"
            android:inputType="number"
            android:maxLength="12"
            android:textSize="17sp"
            android:background="#FFFFFF"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngày sinh"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/edtMockDob"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: 01/01/2003"
            android:inputType="text"
            android:textSize="17sp"
            android:background="#FFFFFF"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giới tính"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/edtMockGender"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nam/Nữ"
            android:inputType="text"
            android:textSize="17sp"
            android:background="#FFFFFF"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngày cấp"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/edtMockIssueDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: 01/01/2021"
            android:inputType="text"
            android:textSize="17sp"
            android:background="#FFFFFF"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nơi cấp"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/edtMockIssuePlace"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: Hà Nội"
            android:inputType="text"
            android:textSize="17sp"
            android:background="#FFFFFF"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Địa chỉ thường trú"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/edtMockAddress"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="top"
            android:hint="Ví dụ: Hà Nội, Việt Nam"
            android:inputType="textMultiLine"
            android:textSize="17sp"
            android:background="#FFFFFF"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <TextView
            android:id="@+id/txtMockCccdMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D71920"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnContinueMockCccd"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Tiếp tục"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="26dp" />

    </LinearLayout>

</ScrollView>