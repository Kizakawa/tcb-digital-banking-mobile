<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutPasswordCreateScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutPasswordCreate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBackPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#222222"
            android:textSize="28sp"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtPasswordLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◆◆"
            android:textColor="#EF2B2D"
            android:textSize="30sp"
            android:layout_marginTop="36dp" />

        <TextView
            android:id="@+id/txtPasswordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vui lòng cài đặt mật khẩu"
            android:textColor="#222222"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <EditText
            android:id="@+id/edtPasswordOpen"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:textSize="20sp"
            android:background="#FFFFFF"
            android:layout_marginTop="34dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <EditText
            android:id="@+id/edtConfirmPasswordOpen"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nhập lại mật khẩu"
            android:inputType="textPassword"
            android:textSize="20sp"
            android:background="#FFFFFF"
            android:layout_marginTop="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <TextView
            android:id="@+id/txtPasswordRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Có 6–20 ký tự\n• Bao gồm số, chữ thường, chữ in hoa và tối thiểu 1 ký tự đặc biệt\n• Không có dấu cách\n• Không trùng tên đăng nhập"
            android:textColor="#666666"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/txtPasswordMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D71920"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnContinuePassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="GO"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C91F1F"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>