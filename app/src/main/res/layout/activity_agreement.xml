<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAgreementScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutAgreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBackAgreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#222222"
            android:textSize="28sp"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtAgreementTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xác nhận thông tin mở tài khoản của bạn"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/txtAgreementContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nội dung xác nhận"
            android:textColor="#333333"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtAgreementMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D71920"
            android:textSize="14sp"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/btnAgreeOpenAccount"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Tôi đã hiểu và đồng ý"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>