<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutIdentitySuccess"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtIdentityPhoto"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="🙂"
        android:textSize="74sp"
        android:gravity="center"
        android:background="#EAF3F7"
        android:layout_marginTop="70dp" />

    <TextView
        android:id="@+id/txtIdentitySuccessTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chúc mừng! Xác minh danh tính thành công"
        android:textColor="#222222"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="34dp" />

    <TextView
        android:id="@+id/txtIdentitySuccessDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bạn hãy điền thêm một vài thông tin nữa để hoàn thành các bước mở tài khoản nhé."
        android:textColor="#555555"
        android:textSize="15sp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/txtPoliceCheck"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="☑  Xác thực Bộ Công an"
        android:textColor="#222222"
        android:textSize="15sp"
        android:gravity="center_vertical"
        android:background="#EAF3F7"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="26dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnNextAfterIdentity"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Tiếp tục"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#000000"
        android:layout_marginBottom="24dp" />

</LinearLayout>