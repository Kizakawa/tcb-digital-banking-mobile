<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOtpSuccess"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtOtpSuccessIcon"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:text="✓"
        android:textSize="64sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="#009A44" />

    <TextView
        android:id="@+id/txtOtpSuccessTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xác thực số điện thoại thành công"
        android:textColor="#222222"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="36dp" />

    <TextView
        android:id="@+id/txtOtpSuccessSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số điện thoại của bạn đã được xác thực. Bước tiếp theo là xác minh danh tính."
        android:textColor="#555555"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnNextAfterOtp"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Tiếp tục"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#000000"
        android:layout_marginTop="70dp" />

</LinearLayout>