<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutIdentityMethod"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtBackIdentityMethod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textSize="28sp"
        android:textColor="#222222"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/txtIdentityMethodTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiếp theo, xác minh danh tính. Chọn phương thức xác minh bạn muốn nhé."
        android:textColor="#222222"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/cardScanCccd"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="▣"
            android:textSize="28sp"
            android:gravity="center"
            android:textColor="#333333" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quét thẻ căn cước gắn chip"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đọc thông tin định danh trực tiếp từ thẻ căn cước"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardConnectVneid"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="☑"
            android:textSize="26sp"
            android:gravity="center"
            android:textColor="#333333" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Liên kết với ứng dụng VNeID"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đồng bộ thông tin định danh từ VNeID"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>