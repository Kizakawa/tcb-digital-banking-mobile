<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutBeautifulAccountScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutBeautifulAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBackBeautifulAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="28sp"
            android:textColor="#222222"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtBeautifulTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo số tài khoản đẹp"
            android:textColor="#222222"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="36dp" />

        <TextView
            android:id="@+id/txtBeautifulDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bạn có thể tự thiết lập số tài khoản theo sở thích. Một số dạng số đẹp như 6868, 9999, 123456 có thể phát sinh phí."
            android:textColor="#555555"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/edtBeautifulAccountNumber"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nhập số tài khoản mong muốn"
            android:inputType="number"
            android:textSize="20sp"
            android:background="#FFFFFF"
            android:layout_marginTop="36dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BBBBBB" />

        <TextView
            android:id="@+id/txtBeautifulSuggestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gợi ý số đẹp"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="26dp" />

        <TextView
            android:id="@+id/txtSuggest6868"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="19036868  -  Tài lộc"
            android:textColor="#222222"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtSuggest9999"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="19039999  -  Tứ quý"
            android:textColor="#222222"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtSuggest123456"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="1903123456  -  Số tiến"
            android:textColor="#222222"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtBeautifulFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phí dự kiến: 0 VND"
            android:textColor="#D71920"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/txtBeautifulMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D71920"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnContinueBeautifulAccount"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Tiếp tục"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>