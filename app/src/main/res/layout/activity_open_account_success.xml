<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOpenAccountSuccessScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutOpenAccountSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtSuccessCheck"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="54sp"
            android:gravity="center"
            android:background="#009A44"
            android:layout_marginTop="44dp" />

        <TextView
            android:id="@+id/txtOpenSuccessTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mở tài khoản thành công!"
            android:textColor="#222222"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/txtOpenSuccessInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin tài khoản"
            android:textColor="#333333"
            android:textSize="15sp"
            android:lineSpacingExtra="8dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtCardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thẻ thanh toán\nTechcombank Study Visa Platinum"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#F4F4F4"
            android:padding="18dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtSuccessNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▣ Thẻ vật lý đã sẵn sàng để dùng\n▣ Bạn sẽ nhận được thẻ trong 3 ngày\n▣ Theo dõi tiến độ giao và kích hoạt thẻ trên ứng dụng"
            android:textColor="#444444"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="22dp" />

        <Button
            android:id="@+id/btnLoginAfterOpen"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Đăng nhập"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>