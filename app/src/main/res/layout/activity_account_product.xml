<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAccountProductScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutAccountProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtBackProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="28sp"
            android:textColor="#222222"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtProductTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xin chào! Bạn đang quan tâm đến sản phẩm nào?"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtProductSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tất cả sản phẩm đều được hỗ trợ tính năng Sinh lời tự động - lãi suất tới 4,1%/năm"
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <LinearLayout
            android:id="@+id/cardStandardAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#EAF3F7"
            android:padding="20dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▱"
                android:textSize="46sp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tài khoản cá nhân tiêu chuẩn"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tận hưởng các tiện ích vượt trội nhất từ ứng dụng và dịch vụ ngân hàng số"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardMerchantAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF2CC"
            android:padding="20dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▰"
                android:textSize="46sp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tài khoản tối ưu cho nhà bán hàng"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dễ tiện chi tiêu, tích hợp công cụ nhận thanh toán và quản lý doanh thu"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>